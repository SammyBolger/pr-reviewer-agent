# github app
GITHUB_APP_ID=
# For local dev, keep the .pem on disk and point at it here.
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.pem
# For hosted deploys (Fly, Render, etc), set the whole PEM as this env var.
# GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=

# anthropic
ANTHROPIC_API_KEY=
REVIEW_MODEL=claude-haiku-4-5

# db (defaults to local sqlite in ./data/reviews.db)
# DATABASE_URL=sqlite:///./data/reviews.db

# chroma persistence dir
# CHROMA_PATH=./.chroma

# server
PORT=8000
LOG_LEVEL=info

# dashboard auth (leave blank to disable /dashboard entirely, or set to a long
# random string and hit /dashboard with `Authorization: Bearer <value>`)
DASHBOARD_TOKEN=
